# Supabase（Project Settings → API からコピー）
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# 許可メール（カンマ区切り）。バックエンド判定で使う想定
ALLOWED_EMAILS=you@example.com

# Gemini はアプリの .env には置かない。
# Supabase secrets: GEMINI_API_KEY（必須）/ GEMINI_MODEL（任意・既定 gemini-2.5-flash）
